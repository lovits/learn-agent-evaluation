<mxfile host="app.diagrams.net" type="device"><diagram id="agent-loop" name="图1  Agent循环：模型决定，Harness执行"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="940" pageHeight="600"><root><mxCell id="0" style="fontColor=#1B1F24;" /><mxCell id="1" parent="0" style="fontColor=#1B1F24;" /><mxCell id="band0" value="Agent 循环 · code.py" style="rounded=1;verticalAlign=top;spacingTop=4;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F7F9FB;strokeColor=#D5DFE8;fontColor=#1B1F24;arcSize=3;align=right;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="550" height="410" as="geometry" /></mxCell><mxCell id="task" value="用户任务&#10;读写文件" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="60" as="geometry" /></mxCell><mxCell id="messages" value="messages&#10;任务与工具结果" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="220" y="160" width="140" height="60" as="geometry" /></mxCell><mxCell id="model" value="模型入口&#10;返回 JSON 动作" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="400" y="50" width="140" height="60" as="geometry" /></mxCell><mxCell id="decision" value="tool_calls&#10;为空？" style="rhombus;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#FFF6E0;strokeColor=#E8C36A;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="390" y="160" width="160" height="90" as="geometry" /></mxCell><mxCell id="bash" value="execute()&#10;校验、权限、执行" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="400" y="310" width="140" height="60" as="geometry" /></mxCell><mxCell id="results" value="真实工具结果&#10;状态与实际输出" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="220" y="430" width="140" height="60" as="geometry" /></mxCell><mxCell id="finished" value="finished&#10;停止工具调用" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fillColor=#E7F6EC;strokeColor=#8BCB9F;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry x="580" y="310" width="140" height="60" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;fontColor=#1B1F24;" edge="1" source="task" target="messages" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="model(messages)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;fontColor=#1B1F24;exitX=0.5;exitY=0;entryX=0;entryY=0.5;" edge="1" source="messages" target="model" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="JSON动作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="model" target="decision" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="否：执行具名工具" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;fontColor=#1B1F24;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="decision" target="bash" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="是：停止" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;fontColor=#1B1F24;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1"