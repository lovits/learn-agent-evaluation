<mxGraphModel adaptiveColors="auto" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="read" value="读取本次记录、产物与任务条件&#10;run / workspace / case" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="30" width="380" height="80" /></mxCell><mxCell id="base" value="分别检查共同条件&#10;正常停止 / 有工具事件 / 产物内容正确" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="160" width="380" height="100" /></mxCell><mxCell id="kind" value="本题要求&#10;观察权限拒绝？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="270" y="320" width="280" height="140" /></mxCell><mxCell id="denied" value="检查存在 denied 事件&#10;denial_observed" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="520" width="310" height="90" /></mxCell><mxCell id="readok" value="检查存在成功的 read_file&#10;read_observed" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="520" width="310" height="90" /></mxCell><mxCell id="all" value="所有 checks&#10;全部为真？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="270" y="680" width="280" height="140" /></mxCell><mxCell id="yes" value="通过本次任务&#10;passed = true" style="rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="880" width="310" height="90" /></mxCell><mxCell id="no" value="本次任务未通过&#10;passed = false" style="rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="880" width="310" height="90" /></mxCell><mxCell id="report" value="返回逐项 checks 与 passed&#10;另存一份 DeepEval 样本，不自动评分" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="180" y="1040" width="460" height="100" /></mxCell><mxCell id="e0" source="read" target="base" value="读取证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;fontSize=19;fontColor=#344054;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e1" source="base" target="kind" value="再检查本题所需事件" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;fontSize=19;fontColor=#344054;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e2" source="kind" target="denied" value="是：denied 任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;fontSize=19;fontColor=#344054;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="e3" source="kind" target="readok" value="否：copy 任务" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#667085;fontSize=19;fontColor=#344054;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" rel