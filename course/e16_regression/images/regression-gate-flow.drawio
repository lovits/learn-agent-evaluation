<?xml version='1.0' encoding='utf-8'?>
<mxGraphModel adaptiveColors="auto" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="freeze" value="复核失败，补充任务&#10;冻结资料、判据与版本" style="rounded=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="20" width="240" height="60" /></mxCell><mxCell id="run" value="同题运行两个版本&#10;独立检查文件＋DeepEval 评分" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="125" width="260" height="65" /></mxCell><mxCell id="known" value="每条都有&#10;有效证据与裁决？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="260" y="235" width="180" height="95" /></mxCell><mxCell id="blocked" value="缺失或评分异常&#10;阻止接受，先补齐" style="rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="5" y="370" width="215" height="60" /></mxCell><mxCell id="pass" value="候选所有关键&#10;条件都通过？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="355" width="180" height="95" /></mxCell><mxCell id="reject" value="有明确失败&#10;拒绝，保留待复核样本" style="rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="440" y="505" width="240" height="60" /></mxCell><mxCell id="accept" value="范围内接受或未见退化&#10;分别保存，不能替代上线决策" style="rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="505" width="290" height="60" /></mxCell><mxCell id="next" value="复核失败原因后再补题&#10;最小修复，重新运行" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="635" width="260" height="60" /></mxCell><mxCell id="edge-0" source="freeze" target="run" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" source="run" target="known" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" source="known" target="blocked" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" source="known" target="pass" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" source="pass" target="reject" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" source="pass" target="accept" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.7;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" source="reject" target="next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" source="accept" target="next" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel>