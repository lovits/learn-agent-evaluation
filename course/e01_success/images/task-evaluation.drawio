<mxGraphModel adaptiveColors="auto" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="read" value="读取本次记录与当前文件&#10;run / workspace / hello.py" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="30" width="380" height="80" /></mxCell><mxCell id="checks" value="分别记录三项判断&#10;正常停止&#10;成功命令输出指定文字&#10;hello.py 的 AST 符合要求" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="160" width="380" height="160" /></mxCell><mxCell id="all" value="三项检查&#10;全部为真？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="270" y="380" width="280" height="140" /></mxCell><mxCell id="yes" value="通过本次任务&#10;passed = true" style="rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="590" width="310" height="90" /></mxCell><mxCell id="no" value="本次任务未通过&#10;passed = false" style="rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="480" y="590" width="310" height="90" /></mxCell><mxCell id="report" value="保留 checks 与 passed&#10;用逐项判断说明原因" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=20;fontColor=#1B1F24;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="220" y="750" width="380" height="80" /></mxCell><mxCell id="e0" source="read" target="checks" value="读取证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;endFill