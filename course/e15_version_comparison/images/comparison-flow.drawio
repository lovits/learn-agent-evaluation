<mxGraphModel adaptiveColors="auto" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="rows" value="按任务ID＋重复编号&#10;对应两个版本" style="rounded=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="210" y="20" width="220" height="60" /></mxCell><mxCell id="valid" value="两侧都有&#10;有效评分？" style="rhombus;fillColor=#FFF6E0;strokeColor=#E8C36A;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="240" y="125" width="160" height="95" /></mxCell><mxCell id="missing" value="缺失或评分失败&#10;保留并报告配对覆盖率" style="rounded=1;fillColor=#FDECEC;strokeColor=#EBA3A3;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="265" width="230" height="60" /></mxCell><mxCell id="delta" value="逐题计算 candidate−baseline&#10;先合并同题重复" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="5" y="265" width="270" height="60" /></mxCell><mxCell id="groups" value="按题型查看失败&#10;按题族重采样看波动" style="rounded=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="15" y="380" width="250" height="60" /></mxCell><mxCell id="cost" value="单列 Agent 延迟与用量&#10;裁判开销另记，价格未知留空" style="rounded=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="380" width="280" height="60" /></mxCell><mxCell id="decision" value="结合质量、退化与覆盖&#10;判断继续观察还是接受改动" style="rounded=1;fillColor=#E7F6EC;strokeColor=#8BCB9F;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=16;fontColor=#1B1F24;" vertex="1" parent="1"><mxGeometry as="geometry" x="210" y="500" width="270" height="60" /></mxCell><mxCell id="edge-0" source="rows" target="valid" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" source="valid" target="missing" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" source="valid" target="delta" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" source="delta" target="groups" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" source="groups" target="decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.5;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" source="rows" target="cost" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" source="cost" target="decision" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=13;labelBackgroundColor=#FFFFFF;entryX=1;entryY=0.5;" edge="1" parent="1"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraph