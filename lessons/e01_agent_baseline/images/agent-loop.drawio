<mxfile host="app.diagrams.net" type="device"><diagram id="agent-loop" name="图1  Agent循环：模型决定，Harness执行"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="940" pageHeight="600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="band0" value="Docker · Harness / code.py" style="rounded=1;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F7F9FB;strokeColor=#D5DFE8;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="550" height="410" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="task" target="messages" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="call_model(messages)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="messages" target="model" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="JSON动作" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="model" target="decision" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="不为空：有命令" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="decision" target="bash" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="为空" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="decision" target="finished" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="收集结果" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source=