<mxfile host="app.diagrams.net" type="device"><diagram id="context-and-memory" name="图：上下文压缩与跨会话记忆的两条支路"><mxGraphModel adaptiveColors="auto" page="1" pageWidth="1140" pageHeight="620"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="band0" value="当前会话：raw保留原始记录，visible控制发给模型的内容" style="rounded=1;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F7F9FB;strokeColor=#D5DFE8;" vertex="1" parent="1"><mxGeometry x="15" y="75" width="1110" height="295" as="geometry" /></mxCell><mxCell id="band1" value="跨会话：新建Conversation会清空上下文，相关记忆从磁盘重新读取" style="rounded=1;verticalAlign=top;spacingTop=10;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F7F9FB;strokeColor=#D5DFE8;" vertex="1" parent="1"><mxGeometry x="15" y="410" width="1110" height="150" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="new" target="visible" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="visible" target="compact" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="准备后再调用" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="compact" target="model" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="原消息不改" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="new" target="raw" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="写盘并留路径" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="compact" target="disk" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="read_file分段取回" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="disk" target="new" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="pairs" target="extract" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="extract" target="memory" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;endArrow=block;strokeColor=#687D93;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" source="memory" target="restart" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="new" value="已有循环的新消息&#10;任务 / 动作 / 工具结果" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="35" y="125" width="190" height="65" as="geometry" /></mxCell><mxCell id="visible" value="visible&#10;实际发送的上下文" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="280" y="125" width="170" height="65" as="geometry" /></mxCell><mxCell id="compact" value="ContextCompactor.prepare&#10;转存 → 裁剪 → 必要时摘要" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="505" y="125" width="260" height="65" as="geometry" /></mxCell><mxCell id="model" value="宿主机模型&#10;返回下一动作" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="865" y="125" width="210" height="65" as="geometry" /></mxCell><mxCell id="raw" value="raw未压缩记录&#10;随运行报告保存" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;" vertex="1" parent="1"><mxGeometry x="35" y="275" width="220" height="65" as="geometry" /></mxCell><mxCell id="disk" value=".task_outputs / .transcripts&#10;结果全文、归档与恢复路径" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;" vertex="1" parent="1"><mxGeometry x="505" y="275" width="260" height="65" as="geometry" /></mxCell><mxCell id="pairs" value="用户请求＋最终回答&#10;仅提取值得长期保留的内容" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="35" y="465" width="230" height="65" as="geometry" /></mxCell><mxCell id="extract" value="模型生成候选&#10;校验scope与重复" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="310" y="465" width="190" height="65" as="geometry" /></mxCell><mxCell id="memory" value=".memory/*.md＋索引&#10;按工作目录持久保存" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#F3EEFF;strokeColor=#B9A6F0;" vertex="1" parent="1"><mxGeometry x="550" y="465" width="245" height="65" as="geometry" /></mxCell><mxCell id="restart" value="新会话重新读取&#10;相关且版本适用 → 新visible" style="rounded=1;whiteSpace=wrap;html=0;fontFamily=Arial;fontSize=14;fillColor=#EEF4FF;strokeColor=#9DB8F2;" vertex="1" parent="1"><mxGeometry x="845" y="465" width="240" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>